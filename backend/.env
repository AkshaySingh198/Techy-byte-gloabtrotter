PORT=5000
NODE_ENV=development

# Database configuration
# Note: Defaults to MySQL, falls back to SQLite file if MySQL connection fails or DB credentials are not provided
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=globetrotter_db

# Auth configuration
JWT_SECRET=globetrotter_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=globetrotter_super_secret_refresh_key_2026
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth2 (configured for future activation)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Payment Gateway (Razorpay UPI Integration)
RAZORPAY_KEY_ID=rzp_test_mockkey12345
RAZORPAY_KEY_SECRET=rzp_test_secret12345
